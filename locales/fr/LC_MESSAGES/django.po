#: domain/content/restoration.py:29
msgid "Only site settings and appearance can be restored here."
msgstr "Seuls les paramètres du site et son apparence peuvent être restaurés ici."

#: domain/content/restoration.py:36
msgid "The saved background image is missing or invalid. No settings were changed."
msgstr "L’image d’arrière-plan enregistrée est manquante ou non valide. Aucun paramètre n’a été modifié."

#: domain/content/restoration.py:64
msgid "This saved version is incompatible with the current settings. No changes were made."
msgstr "Cette version enregistrée est incompatible avec les paramètres actuels. Aucune modification n’a été effectuée."

#: domain/content/restoration.py:80
msgid "Confirm the restoration before applying these settings."
msgstr "Confirmez la restauration avant d’appliquer ces paramètres."

#: domain/content/theme.py:28
msgid "Use six-digit hexadecimal colours, such as #253b33."
msgstr "Utilisez des couleurs hexadécimales à six chiffres, par exemple #253b33."

#: domain/content/theme.py:30
msgid "Choose an approved font."
msgstr "Choisissez une police autorisée."

#: domain/content/theme.py:33
msgid "Text, secondary text and accent colours need at least 4.5:1 contrast against the page and white cards."
msgstr "Les couleurs du texte, du texte secondaire et d’accent doivent avoir un contraste d’au moins 4,5:1 avec la page et les cartes blanches."

#: domain/content/uploads.py:17
msgid "An English image description is required; French may fall back to it."
msgstr "Une description en anglais est obligatoire ; elle est utilisée si la description française est vide."

#: domain/content/uploads.py:31
msgid "Choose an image for this story."
msgstr "Choisissez une image pour cette publication."

#: domain/content/uploads.py:62
msgid "Supply only the supported theme fields."
msgstr "Renseignez uniquement les champs du thème pris en charge."

#: domain/content/uploads.py:64 web/administration/forms.py:115
msgid "Choose an upload or remove the background, not both."
msgstr "Choisissez une image à importer ou retirez l’arrière-plan, sans combiner les deux."

#: domain/content/validators.py:19
msgid "Use a canonical HTTPS Instagram post URL without query parameters."
msgstr "Utilisez l’adresse HTTPS canonique d’une publication Instagram, sans paramètres de requête."

#: web/administration/discovery_guidance.py:22
msgid "Enable after entering your real business details"
msgstr "Activez après avoir saisi les coordonnées réelles de votre entreprise"

#: web/administration/discovery_guidance.py:30
msgid "Required. There is no blank fallback."
msgstr "Obligatoire. Aucune valeur de repli si le champ est vide."

#: web/administration/discovery_guidance.py:31
msgid "Uses the configured public website origin; omitted if none is configured."
msgstr "Utilise l’adresse de base du site public configurée ; omise si aucune adresse n’est configurée."

#: web/administration/discovery_guidance.py:32
msgid "Uses the public origin followed by /en/."
msgstr "Utilise l’adresse de base publique suivie de /en/."

#: web/administration/discovery_guidance.py:33
msgid "Uses the public origin followed by /fr/."
msgstr "Utilise l’adresse de base publique suivie de /fr/."

#: web/administration/discovery_guidance.py:34
msgid "Deployment default follows the indexing configuration. Local and private pages always remain noindex."
msgstr "La valeur par défaut suit la configuration d’indexation du déploiement. Les pages locales et privées restent toujours en noindex."

#: web/administration/discovery_guidance.py:35
msgid "Omitted; the search engine chooses its default image preview."
msgstr "Omis ; le moteur de recherche choisit son aperçu d’image par défaut."

#: web/administration/discovery_guidance.py:36
msgid "Uses the site name."
msgstr "Utilise le nom du site."

#: web/administration/discovery_guidance.py:37
msgid "Required. The initial default is website."
msgstr "Obligatoire. La valeur initiale par défaut est website."

#: web/administration/discovery_guidance.py:38
msgid "Uses the first image on the current feed page; omitted on other pages without an image."
msgstr "Utilise la première image de la page actuelle du fil ; omise sur les autres pages sans image."

#: web/administration/discovery_guidance.py:39
msgid "Required. The initial default is 1200 pixels; enter the actual image width."
msgstr "Obligatoire. La valeur initiale est 1200 pixels ; saisissez la largeur réelle de l’image."

#: web/administration/discovery_guidance.py:40
msgid "Required. The initial default is 630 pixels; enter the actual image height."
msgstr "Obligatoire. La valeur initiale est 630 pixels ; saisissez la hauteur réelle de l’image."

#: web/administration/discovery_guidance.py:41
msgid "Required. The initial default is en_GB."
msgstr "Obligatoire. La valeur initiale par défaut est en_GB."

#: web/administration/discovery_guidance.py:42
msgid "Required. The initial default is fr_FR."
msgstr "Obligatoire. La valeur initiale par défaut est fr_FR."

#: web/administration/discovery_guidance.py:43
msgid "Automatic chooses a large image card when an image exists, otherwise a summary card."
msgstr "Le mode automatique choisit une carte avec grande image si une image existe, sinon une carte de résumé."

#: web/administration/discovery_guidance.py:44
msgid "Uses the default social image, then the first feed image; omitted if neither exists."
msgstr "Utilise l’image sociale par défaut, puis la première image du fil ; omise si aucune n’existe."

#: web/administration/discovery_guidance.py:45
msgid "No icon link is added. The browser may still request /favicon.ico."
msgstr "Aucun lien d’icône n’est ajouté. Le navigateur peut toutefois demander /favicon.ico."

#: web/administration/discovery_guidance.py:46
msgid "No Apple touch icon link is added."
msgstr "Aucun lien d’icône Apple n’est ajouté."

#: web/administration/discovery_guidance.py:47
msgid "No browser theme colour is added."
msgstr "Aucune couleur de thème du navigateur n’est ajoutée."

#: web/administration/discovery_guidance.py:48
msgid "No Google verification tag is added."
msgstr "Aucune balise de vérification Google n’est ajoutée."

#: web/administration/discovery_guidance.py:49
msgid "No Bing verification tag is added."
msgstr "Aucune balise de vérification Bing n’est ajoutée."

#: web/administration/discovery_guidance.py:50
msgid "Unchecked: no business structured data is published."
msgstr "Option décochée : aucune donnée structurée de l’entreprise n’est publiée."

#: web/administration/discovery_guidance.py:51
msgid "Required. The initial default is HomeAndConstructionBusiness."
msgstr "Obligatoire. La valeur initiale par défaut est HomeAndConstructionBusiness."

#: web/administration/discovery_guidance.py:52
msgid "Uses the business website URL followed by #business."
msgstr "Utilise l’URL du site de l’entreprise suivie de #business."

#: web/administration/discovery_guidance.py:53
msgid "No name fallback. A real business name is required when business structured data is enabled."
msgstr "Aucun nom de repli. Le nom réel de l’entreprise est obligatoire lorsque les données structurées sont activées."

#: web/administration/discovery_guidance.py:54
msgid "Uses the public website origin."
msgstr "Utilise l’adresse de base du site public."

#: web/administration/discovery_guidance.py:55
msgid "Uses the default social image; omitted if none is configured."
msgstr "Utilise l’image sociale par défaut ; omise si aucune n’est configurée."

#: web/administration/discovery_guidance.py:56
#: web/administration/discovery_guidance.py:61
msgid "Omitted from business structured data."
msgstr "Omis des données structurées de l’entreprise."

#: web/administration/discovery_guidance.py:57
msgid "No address fallback. Required when business structured data is enabled."
msgstr "Aucune adresse de repli. Obligatoire lorsque les données structurées de l’entreprise sont activées."

#: web/administration/discovery_guidance.py:58
msgid "No town fallback. Required when business structured data is enabled."
msgstr "Aucune ville de repli. Obligatoire lorsque les données structurées de l’entreprise sont activées."

#: web/administration/discovery_guidance.py:59
msgid "No postcode fallback. Required when business structured data is enabled."
msgstr "Aucun code postal de repli. Obligatoire lorsque les données structurées de l’entreprise sont activées."

#: web/administration/discovery_guidance.py:60
msgid "Required. The initial default is GB."
msgstr "Obligatoire. La valeur initiale par défaut est GB."

#: web/administration/discovery_guidance.py:74
msgid "Discover our latest projects and get in touch."
msgstr "Découvrez nos derniers projets et contactez-nous."

#: web/administration/discovery_guidance.py:77
msgid "Uses the other language if supplied, then the page name and site name."
msgstr "Utilise l’autre langue si elle est renseignée, puis le nom de la page et du site."

#: web/administration/discovery_guidance.py:78
msgid "Uses the other language if supplied, then the site introduction, then the page title."
msgstr "Utilise l’autre langue si elle est renseignée, puis la présentation du site et enfin le titre de la page."

#: web/administration/discovery_guidance.py:84
msgid "Projects, stories and inspiration from Fieldnotes."
msgstr "Projets, récits et inspirations de Fieldnotes."

#: web/administration/discovery_guidance.py:85
msgid "A bright living room designed by Fieldnotes"
msgstr "Un salon lumineux conçu par Fieldnotes"

#: web/administration/discovery_guidance.py:86
msgid "See our latest projects and stories."
msgstr "Découvrez nos derniers projets et publications."

#: web/administration/discovery_guidance.py:87
msgid "Interior design and renovation services."
msgstr "Services de décoration intérieure et de rénovation."

#: web/administration/discovery_guidance.py:95
msgid "Uses the other language if supplied, then each page’s own title or description."
msgstr "Utilise l’autre langue si elle est renseignée, puis le titre ou la description propre à chaque page."

#: web/administration/discovery_guidance.py:98
msgid "Uses the homepage canonical URL. Other pages always use their own canonical URL."
msgstr "Utilise l’URL canonique de la page d’accueil. Les autres pages utilisent toujours leur propre URL canonique."

#: web/administration/discovery_guidance.py:101
msgid "Uses the other language if supplied; omitted if both languages are blank."
msgstr "Utilise l’autre langue si elle est renseignée ; omis si les deux langues sont vides."

